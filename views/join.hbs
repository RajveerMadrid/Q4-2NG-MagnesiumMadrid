<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Madrid - Club Sign-Up Form</title>
  <link rel="stylesheet" type="text/css" href="/styles.css">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
</head>

<body>
  <h1>Madrid - 9 Mg - 2025 April 14</h1>
  <form action="/submit" method="post" onsubmit="submission()" onreset="disappear()">
    
    <div class="info-chunk">
        <div class="form-info">
            <label for="studentID">Student ID:</label>
            <input type="number" id="studentID" name="studentID" required>
         </div>

         <div class="form-info">
            <label for="fullName">Full Name:</label>
            <input type="text" id="fullName" name="fullName" required>
        </div>
   
        <div class="form-info">
            <label for="birthday">Birthday:</label>
            <input type="date" id="birthday" name="birthday" required>
        </div>

        <div class="form-info">
            <label for="email">Email:</label>
            <input type="email" id="email" name="email" required>
        </div>
    </div>

    <div class="info-chunk">
        <div class="form-info">
            <label for="mobile">Mobile Phone:</label>
            <input type="text" id="mobile" name="mobile" required>
        </div>

        <div class="form-info">
            <label for="gradeLevel">Grade Level:</label>
            <select id="gradeLevel" name="gradeLevel" required>
                <option value="">Select your Grade Level</option>
                <option value="7">7</option>
                <option value="8">8</option>
                <option value="9">9</option>
                <option value="10">10</option>
                <option value="11">11</option>
                <option value="12">12</option>
            </select>
        </div>

        <div class="form-info">
            <label for="type">Intern/Extern:</label>
            <label>
                <input type="radio" name="type" value="intern" required>
                Intern
            </label>
            <label>
                <input type="radio" name="type" value="extern" required> 
                Extern
            </label>
        </div>

        <div class="form-info">
            <label for="preferredClub">Organization: </label>
            <select id="preferredClub" name="preferredClub" onchange="filterStudents()">
            <option value="all">All Clubs</option>
            {{#each clubArray}}
              <option value="{{this.name}}">{{this.name}}</option>
            {{/each}}
            </select>
        </div>

        <div class="form-info">
            <label for="reason">Why do you want to join?</label>
            <br/>
            <textarea id="reason" name="reason" rows="7" columns="70" required></textarea>
        </div>
    </div>

    <input type="submit">
    <input type="reset">
  </form>
   <p style="max-width: 600px; margin: auto; padding: 20px;">
        <a href="/">
          <button type="button"> Click Here to See Member list </button>
        </a>
    </p>
     

  <script>
    function submission() {
        confirm("Are you sure you want to submit?")
    }

    function disappear() {
        confirm("Are you sure you want to reset?")
    }
  </script>
</body>
</html>